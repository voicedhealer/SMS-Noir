# Environnement des tests automatisés du moment IA.
#
# Aucun secret ici, et c'est le point : sans MISTRAL_API_KEY, le vrai
# fournisseur échouerait bruyamment. Si un test passe avec ce fichier, c'est
# que le simulé était bien en service.
#
#   supabase functions serve --env-file supabase/functions/.env.stub
#   python3 scripts/test-ai-moment.py
AI_PROVIDER=stub
